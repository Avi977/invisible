# invisible main config.

[vps]
# Filled in once you decide to deploy invisible-server to srv982719.
host = ""
identity = "~/.ssh/id_ed25519"
use_mosh = false

[orchestrator]
default_max_iters = 4
codex_model = "gpt-5-codex"
claude_model = "claude-sonnet-4-6"

# ── Clients ─────────────────────────────────────────────────────────────
[[clients]]
name = "personal"

# ── Projects ────────────────────────────────────────────────────────────
[[projects]]
name = "jobslayer"
client = "personal"
repo_path = "~/Projects/jobslayer"
# vps_repo_path  = "/srv/jobslayer"   # set later if you want VPS handoff
max_iters = 3

# ── Terminals ───────────────────────────────────────────────────────────
# Per-pane config consumed by `bin/invisible-pty` at startup. Each
# `[[terminals]]` block describes one pane the daemon will accept on
# `ws://127.0.0.1:8091/pty/{id}`. Panes whose `id` isn't listed here fall
# back to a default plain-bash pane in your home dir.
#
# Required fields:
#   id    must match ^[a-z0-9_-]{1,32}$ (lowercase letters, digits, `_`, `-`)
#   kind  one of "bash" or "ssh"
#
# Optional fields:
#   cwd   string, ~/... allowed (expanded at spawn time)
#   env   table of strings (overlays os.environ for this pane only)
#
# kind = "ssh" additionally requires:
#   host  string — passed as `ssh <host>`. Host comes from THIS file ONLY;
#         the frontend cannot override it via the WebSocket URL or query
#         string. See 02-PLAN.md threat-model T-02-01.

[[terminals]]
id = "local-1"
kind = "bash"
cwd = "~/code"

[[terminals]]
id = "vps-srv"
kind = "ssh"
host = "srv982719"

# ── Calendar ────────────────────────────────────────────────────────────
# Event sources for the Calendar page. All three are optional; if none are
# set, /api/v1/calendar returns []. iCal URLs MUST use https:// and resolve
# to public addresses — RFC1918 / loopback / link-local hosts are rejected
# by the SSRF guard in lib/api/calendar._safe_ics_url.
#
# A third source — ~/.invisible/events.json — is auto-discovered when the
# file exists and does NOT need to be configured here. Schema is a JSON
# array of {title, start, end, color?, project_id?} objects (RFC3339 times).

[calendar]
# 32-char Notion database id of your calendar database. Leave empty to
# disable the Notion source. The database must have a "Date" property
# (Notion's default date-property type); optionally a "Color" select
# property whose option names are #RRGGBB hex codes, and a "Project"
# relation property to link events to project rows for color resolution.
notion_database_id = ""
# Public iCal feed URLs. Example:
#   ["https://calendar.google.com/calendar/ical/YOUR_ID/public/basic.ics"]
ics_urls = []
