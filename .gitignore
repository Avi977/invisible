# ── Secrets (NEVER commit) ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
.ssh/

# ── Local config (user-specific; commit the .example) ──────────────────
invisible.toml

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Runtime state ──────────────────────────────────────────────────────
logs/
*.log
# Per-project action-hub store (context.md, daily logs, backups, suggestions.json)
# created by bin/invisible-brief + the brief API under the repo root. Per-machine,
# daemon-generated — not source. Anchored so it can't match a nested projects/ dir.
/projects/
worktrees/
checkpoints/
.invisible-checkpoint.json
.invisible-state/
# per-machine tool-workflow state (daemon-created under the repo root when run
# with INVISIBLE_HOME=$(pwd) inside a worktree — see INV-01 D-16).
# Anchored to repo root so it does NOT match .github/workflows/.
/workflows/

# ── GSD per-worktree state ─────────────────────────────────────────────
# Active workstream is per-worktree, not shared. Each git worktree picks
# its own via `gsd-sdk query workstream.set <name>`.
.planning/active-workstream

# START_HERE.md is a per-worktree session-bootstrap scaffold (e.g. created
# by the worktree-setup flow in invisible-ws/). It is useful only when
# opening a worktree, not on main. Tracking it here would mean every
# session's local scaffolding leaks into PRs.
START_HERE.md
START_HERE.*.local.md

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# ── Tauri / Node (future UI shell) ─────────────────────────────────────
node_modules/
src-tauri/target/
# Cargo.lock is INTENTIONALLY committed for the binary crate
# (Rust convention; Phase 3's signed/notarised macOS builds need
# reproducible deps). Do not re-add it here.
dist/
*.dmg
*.msi
*.exe.zip
.gstack/
