#!/usr/bin/env python3
"""invisible-doctor — preflight checklist for the cockpit.

Verifies the things that go wrong *between* installs, not at install time:
  - codex / claude / git / ssh / tmux on PATH
  - $INVISIBLE_HOME populated with prompts + lib + bin
  - .env has NOTION_TOKEN + the 6 DB ids + (optional) Telegram creds
  - invisible.toml parses and every project's repo_path is a git repo
  - vps.host resolves via SSH non-interactively (BatchMode)
  - Notion API responds with the configured token

Exit code:
  0  everything OK or only WARNs
  1  any FAIL

Output is human-readable; pipe through `grep FAIL` for CI.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))

from config import home, load_env, load_toml  # noqa: E402


PASS = "PASS"
WARN = "WARN"
FAIL = "FAIL"

ICON = {PASS: "✓", WARN: "•", FAIL: "✗"}
COLOR = {PASS: "\033[32m", WARN: "\033[33m", FAIL: "\033[31m"}
RESET = "\033[0m"


# Host-validation regex — MUST match lib/api/tree_vps.py::_HOST_RE (line 113).
# Defense-in-depth gate for T-INV01H-03; any edit here MUST also be applied to
# lib/api/tree_vps.py and vice versa, otherwise the doctor and the walker will
# disagree about which hosts are acceptable.
_HOST_RE = re.compile(r"^(?:[A-Za-z0-9_.-]+@)?[A-Za-z0-9._-]+$")


def _sanitize_ssh_stderr(line: str) -> str:
    """Redact filesystem-revealing content from an SSH stderr snippet.

    Strips macOS / Linux absolute paths under user home dirs (`/Users/<name>/...`,
    `/home/<name>/...`) and `id_*` / `*.pem` keyfile names. Keeps the line under
    120 chars (matches the original snippet truncation).

    Mitigates T-INV01H-04 — the doctor's FAIL detail string must never leak
    `~/.ssh/id_ed25519` or similar paths into CI logs / shared-screen capture.
    """
    s = line or ""
    # Replace user-home paths first (the path tokens may themselves contain
    # `id_*` substrings; doing paths first avoids double-substituting).
    s = re.sub(r"/Users/[^/ \t]+/[^\s]*", "<path>", s)
    s = re.sub(r"/home/[^/ \t]+/[^\s]*", "<path>", s)
    # Identity-file basenames (id_rsa, id_ed25519, id_special, …).
    s = re.sub(r"\bid_[A-Za-z0-9_]+\b", "<keyfile>", s)
    # PEM files anywhere.
    s = re.sub(r"\b[\w.-]+\.pem\b", "<keyfile>", s)
    if len(s) > 120:
        s = s[:120]
    return s


def report(results: list[tuple[str, str, str]]) -> int:
    """Print results, return rc."""
    width = max(len(name) for name, _, _ in results) + 2
    for name, status, detail in results:
        color = COLOR.get(status, "") if sys.stdout.isatty() else ""
        reset = RESET if color else ""
        print(f"  {color}{ICON[status]} {status:<4}{reset} {name:<{width}} {detail}")
    fails = sum(1 for _, s, _ in results if s == FAIL)
    warns = sum(1 for _, s, _ in results if s == WARN)
    passes = sum(1 for _, s, _ in results if s == PASS)
    print(f"\n  {passes} pass · {warns} warn · {fails} fail")
    return 1 if fails else 0


# ---------- individual checks ----------

def check_binary(name: str) -> tuple[str, str, str]:
    p = shutil.which(name)
    if p:
        return (f"bin: {name}", PASS, p)
    return (f"bin: {name}", FAIL, "not on PATH")


def check_invisible_home() -> list[tuple[str, str, str]]:
    h = home()
    out: list[tuple[str, str, str]] = []
    out.append(("INVISIBLE_HOME", PASS if h.is_dir() else FAIL,
                str(h) + ("" if h.is_dir() else "  (missing — run scripts/install.sh)")))
    for sub in ("bin", "lib", "prompts", "worktrees", "logs"):
        d = h / sub
        out.append((f"  ./{sub}",
                    PASS if d.is_dir() else (WARN if sub == "worktrees" else FAIL),
                    "ok" if d.is_dir() else "missing"))
    for prompt in ("codex_task.md", "claude_review.md", "standup.md", "gsd_pick.md"):
        f = h / "prompts" / prompt
        out.append((f"  prompts/{prompt}",
                    PASS if f.exists() else FAIL,
                    "ok" if f.exists() else "missing"))
    return out


def check_env() -> list[tuple[str, str, str]]:
    out: list[tuple[str, str, str]] = []
    env_path = home() / ".env"
    if not env_path.exists():
        return [(".env", FAIL, f"{env_path} not found — copy from .env.example")]
    notion_tok = os.environ.get("NOTION_TOKEN", "")
    if not notion_tok:
        out.append(("NOTION_TOKEN", FAIL, "unset — Notion writes will no-op"))
    elif notion_tok.endswith("xxxx") or "xxxxxx" in notion_tok:
        out.append(("NOTION_TOKEN", FAIL,
                    "still set to the .env.example placeholder — paste your real token"))
    else:
        out.append(("NOTION_TOKEN", PASS, "set"))

    def _looks_placeholder(s: str) -> bool:
        return "xxxxxxxx" in s or s == s[:1] * len(s)

    for db in ("CLIENTS", "PROJECTS", "REVIEWS", "STANDUPS", "GSD", "HEALTH"):
        var = f"NOTION_DB_{db}"
        v = os.environ.get(var, "")
        if not v:
            out.append((var, FAIL, "unset — run invisible-bootstrap-notion"))
        elif _looks_placeholder(v):
            out.append((var, FAIL,
                        "placeholder value — run invisible-bootstrap-notion"))
        elif len(v) < 30:
            out.append((var, WARN, "set but looks malformed (too short)"))
        else:
            out.append((var, PASS, f"{v[:8]}…"))
    tg_tok = os.environ.get("TELEGRAM_BOT_TOKEN")
    tg_chat = os.environ.get("TELEGRAM_CHAT_ID")
    if tg_tok and tg_chat:
        out.append(("Telegram", PASS, "configured"))
    else:
        out.append(("Telegram", WARN,
                    "not configured — Telegram alerts are no-op (optional)"))
    return out


def check_notion_api() -> tuple[str, str, str]:
    tok = os.environ.get("NOTION_TOKEN")
    if not tok:
        return ("Notion API", WARN, "skipped (NOTION_TOKEN unset)")
    req = urllib.request.Request(
        "https://api.notion.com/v1/users/me",
        headers={"Authorization": f"Bearer {tok}",
                 "Notion-Version": "2022-06-28"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            body = json.loads(r.read())
            who = body.get("name") or body.get("bot", {}).get("owner", {}).get("type", "?")
            return ("Notion API", PASS, f"authenticated as {who}")
    except urllib.error.HTTPError as e:
        return ("Notion API", FAIL, f"HTTP {e.code} — token rejected")
    except Exception as e:
        return ("Notion API", FAIL, f"{e}")


def check_repos(cfg: dict) -> list[tuple[str, str, str]]:
    out: list[tuple[str, str, str]] = []
    projects = cfg.get("projects", []) or []
    if not projects:
        return [("projects in invisible.toml", WARN,
                 "none configured — add [[projects]] blocks")]
    for p in projects:
        name = p.get("name", "?")
        repo = Path(p.get("repo_path", "")).expanduser()
        if not repo.exists():
            out.append((f"project: {name}", FAIL, f"repo_path {repo} missing"))
        elif not (repo / ".git").exists():
            out.append((f"project: {name}", FAIL, f"{repo} is not a git repo"))
        else:
            tag = "" if p.get("notion_id") else "  (no notion_id; invisible-new will create one)"
            out.append((f"project: {name}", PASS, f"{repo}{tag}"))
    return out


def check_ssh(cfg: dict) -> tuple[str, str, str]:
    """Probe the VPS over SSH and report the ControlMaster reuse state.

    Behavior, in order:
      1. Empty / missing ``vps.host`` → WARN (matches the
         ``VPS_NOT_CONFIGURED`` graceful-degradation contract in
         ``lib/api/tree_vps.py walk_all``).
      2. Host failing the validation regex → FAIL (bad value is NOT echoed
         back; avoids log-injection in CI output).
      3. First ``ssh ... echo ok`` succeeds → run it again and time the second
         call. Second call under 200ms → ``master=cached`` (ControlMaster
         reuse confirmed). Slower → ``master=new`` (auth works but multiplex
         not wired; suggest adding ControlMaster directives to ~/.ssh/config).
      4. First call fails → FAIL with a sanitized one-line stderr snippet.

    Worst-case runtime is bounded: first ssh has a 12s outer timeout (8s
    ConnectTimeout + slack), second has a 6s timeout. Documented under
    T-INV01H-06 in the threat register.

    The ``ssh`` argv deliberately omits ``-i <identity>`` — the doctor is
    verifying the user's normal interactive SSH path, so identity resolution
    should follow ``~/.ssh/config`` (not invisible.toml).
    """
    vps = (cfg.get("vps") or {})
    host = (vps.get("host") or "").strip()
    if not host:
        return (
            "ssh: vps.host",
            WARN,
            "no vps.host configured — Folders/VPS column will return 503 "
            "(graceful degradation, by design)",
        )
    if not _HOST_RE.match(host):
        return (
            f"ssh: {host}",
            FAIL,
            "invalid host value — must match "
            "^(?:[A-Za-z0-9_.-]+@)?[A-Za-z0-9._-]+$",
        )

    argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
            host, "echo", "ok"]

    # First invocation — cold (may set up the ControlMaster).
    try:
        t0 = time.perf_counter()
        r1 = subprocess.run(argv, capture_output=True, text=True,
                            timeout=12, check=False)
        _t1 = time.perf_counter() - t0  # noqa: F841 — kept for future timing reports
    except subprocess.TimeoutExpired:
        return (f"ssh: {host}", FAIL, "first ssh timed out (>12s)")

    if r1.returncode != 0:
        first_line = (r1.stderr.strip().splitlines() or [""])[0]
        snippet = _sanitize_ssh_stderr(first_line)
        if not snippet:
            snippet = f"rc={r1.returncode}"
        return (f"ssh: {host}", FAIL, snippet)

    if "ok" not in (r1.stdout or ""):
        return (
            f"ssh: {host}",
            WARN,
            "auth ok but echo output unexpected — check remote shell",
        )

    # Second invocation — timing probe for ControlMaster reuse.
    try:
        t0 = time.perf_counter()
        r2 = subprocess.run(argv, capture_output=True, text=True,
                            timeout=6, check=False)
        t2 = time.perf_counter() - t0
    except subprocess.TimeoutExpired:
        return (f"ssh: {host}", PASS,
                "non-interactive auth works · master=lost (second ssh timed out)")

    if r2.returncode != 0:
        return (f"ssh: {host}", PASS, "non-interactive auth works · master=lost")

    if t2 < 0.200:
        return (f"ssh: {host}", PASS, "non-interactive auth works · master=cached")
    return (
        f"ssh: {host}",
        PASS,
        f"non-interactive auth works · master=new ({t2 * 1000:.0f}ms — "
        "add ControlMaster to ~/.ssh/config)",
    )


def check_codex_login() -> tuple[str, str, str]:
    """Verify the codex CLI is actually authenticated.

    Catches the 401-Unauthorized failure mode that surfaces only mid-run
    otherwise (codex starts, reads the prompt, then dies on the OpenAI
    websocket handshake). `codex login status` exits 0 when authenticated.
    """
    if not shutil.which("codex"):
        return ("codex auth", FAIL, "binary missing")
    r = subprocess.run(["codex", "login", "status"], capture_output=True,
                       text=True, timeout=10, check=False)
    msg = (r.stdout + r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else ""
    if r.returncode == 0:
        return ("codex login", PASS, msg or "authenticated")
    return ("codex login", FAIL,
            f"{msg or 'not logged in'} — run `codex login`")


def check_claude_login() -> tuple[str, str, str]:
    """Verify the claude CLI is actually authenticated.

    `claude auth status` returns a JSON envelope with loggedIn:true and exits
    0 when authenticated. We parse it so the doctor surfaces the auth method
    (claude.ai vs API key) rather than the raw JSON blob.
    """
    if not shutil.which("claude"):
        return ("claude auth", FAIL, "binary missing")
    r = subprocess.run(["claude", "auth", "status"], capture_output=True,
                       text=True, timeout=10, check=False)
    if r.returncode != 0:
        snippet = (r.stderr or r.stdout).strip().splitlines()[0] if (r.stderr or r.stdout) else ""
        return ("claude auth", FAIL,
                f"{snippet or 'not logged in'} — run `claude auth login`")
    try:
        info = json.loads(r.stdout)
    except json.JSONDecodeError:
        return ("claude auth", WARN, "status returned non-JSON; assuming ok")
    if not info.get("loggedIn"):
        return ("claude auth", FAIL, "loggedIn=false — run `claude auth login`")
    parts = [info.get("authMethod") or "unknown"]
    if info.get("email"):
        parts.append(info["email"])
    if info.get("subscriptionType"):
        parts.append(info["subscriptionType"])
    return ("claude auth", PASS, " · ".join(parts))


def main() -> int:
    load_env()
    cfg = load_toml()

    print("invisible-doctor — preflight\n")

    print("[binaries]")
    bin_results = [check_binary(b) for b in ("codex", "claude", "git", "ssh", "tmux")]
    rc = report(bin_results)

    print("\n[layout]")
    rc |= report(check_invisible_home())

    print("\n[env]")
    rc |= report(check_env())

    print("\n[notion]")
    rc |= report([check_notion_api()])

    print("\n[auth]")
    rc |= report([check_codex_login(), check_claude_login()])

    print("\n[repos]")
    rc |= report(check_repos(cfg))

    print("\n[ssh]")
    rc |= report([check_ssh(cfg)])

    print()
    return 1 if rc else 0


if __name__ == "__main__":
    raise SystemExit(main())
